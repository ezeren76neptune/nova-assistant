<?xml version="1.0" encoding="utf-8"?>
<!-- Local servers (Home Assistant, your own LLM server): allow plain http on the LAN and trust
     certificates from CAs you installed on the phone (self-hosted / internal HTTPS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
